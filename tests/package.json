{
  "name": "care-hours-tests",
  "private": true,
  "description": "Automated tests for Care Hours. They run the app in a real browser against a fake online database, so your real data is never touched.",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:iphone": "playwright test --project=iphone",
    "test:android": "playwright test --project=android",
    "test:all": "playwright test",
    "test:ui": "playwright test --project=chromium --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4"
  }
}
